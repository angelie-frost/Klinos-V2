+// The keyboard as a SOLID slab with the inter-key grooves cut into it, rather
+// than proud caps standing on a well floor. Same visible surface - the groove
+// bottom IS the well floor - but the volume beneath is solid, so a ray grazing
+// the deck terminates on the slab instead of threading the 3mm channels between
+// caps. That is worth a lot of march budget: on the prototype at full pixel
+// density, proud caps took Front from 46 steps to 440 of the 480 available and
+// ran rays out at Hero front; grooves in a solid slab bring it back to 343.
+// Same grazing-ray problem the deck itself had, and the same kind of fix.
+float sdKeyboard(vec3 p, out float plan) {
+  plan = 1e3;
+  if (abs(p.x) > KB_WX + 4.0 || p.z < KB_Z0 - 4.0 || p.z > KB_Z1 + 4.0 ||
+      p.y > KB_RELIEF + 2.0 || p.y < -KB_WELL - 3.0) return 1e3;
+  float slabPlan = sdRRect(vec2(p.x, p.z - (KB_Z0 + KB_Z1) * 0.5),
+                           vec2(KB_WX, (KB_Z1 - KB_Z0) * 0.5), 4.0);
+  float slabH = abs(p.y - (KB_RELIEF - KB_WELL) * 0.5) - (KB_RELIEF + KB_WELL) * 0.5;
+  plan = kbPlan(p.xz);
+  float groove = max(-plan, -KB_WELL - p.y);
+  float d = max(cyl(slabPlan, slabH), -groove);
+  // Dish the cap tops. For a cap of half-size a the radius from its centre is
+  // a + plan (plan is negative inside), so this reuses the per-key work.
+  float r = max(KB_CAPX * 0.5 + plan, 0.0);
+  float dishY = KB_RELIEF + KB_DISHR - KB_DISH
+              - sqrt(max(KB_DISHR * KB_DISHR - r * r, 0.0));
+  if (plan < 0.0) d = max(d, dishY - p.y);
+  return d;
+}
+
+float sdKeyboardD(vec3 p) { float pl; return sdKeyboard(p, pl); }
